  "briefing": {
    "title": "THE FIRST VEIN",
    "story": [
      "VANE: \"This is the First Vein. Everything the Reach burns for comes out of this",
      "wound. Seal it, and the Reach starves but Aether lives. Harness it, and we hold",
      "a god by the tail. Choose, Warden. I'll load the charges either way.\"",
      "",
      "CORR: \"Whatever you choose — the Directorate fleet arrives in one hour.\""
    ],
    "objectives": [
      "Decide the fate of the First Vein"
    ]
  },
  "debrief": {
    "win": [
      "Aether Prime will remember what you chose."
    ],
    "lose": [
      "The Directorate decides for everyone."
    ]
  },
  "choice": {
    "prompt": "The First Vein lies open before you. The charges are set; the Chorus is listening; the Directorate fleet burns through the sky. What do you do with the wound the world bleeds from?",
