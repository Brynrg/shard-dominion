      {
        "id": "seal",
        "label": "⛏ SEAL THE DEEP",
        "blurb": "Collapse the Vein forever. The Reach starves; the planet sleeps. Hold the site while the charges set — everything will try to stop you."
      },
      {
        "id": "harness",
        "label": "⬡ HARNESS THE CHORUS",
        "blurb": "Bond the planet to human hands. Overdrive economy — but the corruption spreads, and the Directorate must fall before it consumes you."
      }
    ]
  },
