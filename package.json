{
  "name": "shard-dominion",
  "private": true,
  "version": "0.51.0",
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "description": "IP-clean late-90s Westwood-style web RTS. Pure deterministic sim + Canvas2D. Built slice by slice against pinned contracts.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "validate:missions": "vitest run tests/unit/missions.test.ts",
    "test:live": "playwright test"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.45.0",
    "@types/node": "^22.7.5",
    "@types/ws": "^8.18.1",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vite": "^5.4.9",
    "vitest": "^2.1.3",
    "ws": "^8.21.0"
  }
}
